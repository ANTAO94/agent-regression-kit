{
  "baseline": "baseline.trace.json",
  "candidate": "work/candidate.trace.json",
  "report": "work/compare.json",
  "format": "json",
  "final_answer_mode": "claims-only",
  "contract": {
    "required_claims": [
      "final_answer.claims.summary_present",
      "final_answer.claims.findings_count",
      "final_answer.claims.source_count",
      "final_answer.claims.confidence",
      "final_answer.claims.facts.checkpointer_scope",
      "final_answer.claims.facts.store_scope",
      "final_answer.claims.facts.thread_id_required",
      "final_answer.claims.facts.in_memory_survives_restart",
      "final_answer.claims.facts.evidence_ids"
    ],
    "assertions": [
      {
        "path": "final_answer.claims.summary_present",
        "equals": true
      },
      {
        "path": "final_answer.claims.facts.checkpointer_scope",
        "equals": "single_thread"
      },
      {
        "path": "final_answer.claims.facts.store_scope",
        "equals": "cross_thread"
      },
      {
        "path": "final_answer.claims.facts.thread_id_required",
        "equals": true
      },
      {
        "path": "final_answer.claims.facts.in_memory_survives_restart",
        "equals": false
      }
    ],
    "must_call": [
      {
        "tool": "web_search",
        "arguments": {"input": "LangGraph persistence checkpointer thread_id official docs"}
      },
      {
        "tool": "web_search",
        "arguments": {"input": "LangGraph store cross-thread memory official docs"}
      },
      {
        "tool": "web_search",
        "arguments": {"input": "LangGraph in-memory checkpointer restart official docs"}
      }
    ],
    "tool_limits": [
      {
        "tool": "web_search",
        "min_calls": 3,
        "max_calls": 3
      }
    ],
    "normalizers": [
      {
        "path": "final_answer.claims.facts.evidence_ids",
        "type": "sort"
      }
    ],
    "path_rules": {
      "mode": "unordered_subset",
      "any_of": [
        [
          {"tool": "web_search"},
          {"tool": "web_search"},
          {"tool": "web_search"}
        ]
      ]
    }
  }
}
