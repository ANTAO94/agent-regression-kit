{
  "baseline": "../../baselines/order-123.trace.json",
  "candidate": "../../work/deepseek-live.trace.json",
  "report": "../../work/deepseek-live.report.json",
  "format": "json",
  "final_answer_mode": "claims-only",
  "contract": {
