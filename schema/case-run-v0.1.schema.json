{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Regression CaseRun v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_run_id", "case_id", "case_revision", "definition_sha256", "execution_mode", "candidate_ref", "agent_revision", "report_ref", "outcome", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "case_run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision": {"type": "integer", "minimum": 1},
    "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_mode": {"const": "evidence_compare"},
    "candidate_ref": {"type": ["object", "null"]},
    "execution_ref": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
    "agent_revision": {"type": "string"},
    "report_ref": {"type": ["object", "null"]},
    "outcome": {"enum": ["pass", "fail", "inconclusive", "error"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "report": {"type": "object"},
    "error": {"type": "string"}
  },
  "$defs": {"reference": {"type": "object", "additionalProperties": false,
    "required": ["path", "sha256"], "properties": {
      "path": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }}}
}
