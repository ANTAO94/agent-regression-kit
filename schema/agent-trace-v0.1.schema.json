{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-regression-kit.dev/schema/agent-trace-v0.1.schema.json",
  "title": "AgentTrace v0.1",
  "type": "object",
  "required": ["schema_version", "run_id", "agent", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/tool_call"},
          {"$ref": "#/$defs/tool_result"},
          {"$ref": "#/$defs/final_answer"}
        ]
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "event_base": {
      "type": "object",
      "required": ["sequence", "type"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "type": {"enum": ["tool_call", "tool_result", "final_answer"]},
        "metadata": {"type": "object"}
      }
    },
    "tool_call": {
      "allOf": [
        {"$ref": "#/$defs/event_base"},
        {
          "type": "object",
          "required": ["sequence", "type", "call_id", "tool", "arguments"],
          "properties": {
            "sequence": {"type": "integer", "minimum": 1},
            "type": {"const": "tool_call"},
            "call_id": {"type": "string", "minLength": 1},
            "tool": {"type": "string", "minLength": 1},
            "arguments": {"type": "object"},
            "metadata": {"type": "object"}
          },
          "additionalProperties": false
        }
      ]
    },
    "tool_result": {
      "allOf": [
        {"$ref": "#/$defs/event_base"},
        {
          "type": "object",
          "required": ["sequence", "type", "call_id", "result", "is_error"],
          "properties": {
            "sequence": {"type": "integer", "minimum": 1},
            "type": {"const": "tool_result"},
            "call_id": {"type": "string", "minLength": 1},
            "result": true,
            "is_error": {"type": "boolean"},
            "error": {"type": "string"},
            "metadata": {"type": "object"}
          },
          "additionalProperties": false
        }
      ]
    },
    "final_answer": {
      "allOf": [
        {"$ref": "#/$defs/event_base"},
        {
          "type": "object",
          "required": ["sequence", "type", "text"],
          "properties": {
            "sequence": {"type": "integer", "minimum": 1},
            "type": {"const": "final_answer"},
            "text": {"type": "string"},
            "claims": {"type": "object"},
            "metadata": {"type": "object"}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
