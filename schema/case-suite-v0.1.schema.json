{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Regression Case Suite Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["case", "candidate"], "properties": {
        "case": {"type": "string", "minLength": 1},
        "candidate": {"type": "string", "minLength": 1},
        "execution": {"type": "string", "minLength": 1},
        "agent_revision": {"type": "string", "minLength": 1}
      }}}
  }
}
