{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Regression Incident v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "incident_id", "title", "source_kind", "summary", "evidence_refs", "reported_at", "status", "case_refs"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "incident_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["injected", "historical_bug", "user_feedback", "ci_failure"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
    "reported_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "triaged", "resolved"]},
    "case_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "resolution": {"type": ["object", "null"], "description": "Legacy declaration only; never proves closure. Validate an independent IncidentResolution record."}
  },
  "$defs": {
    "reference": {"type": "object", "additionalProperties": false,
      "required": ["role", "path", "sha256"], "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }}
  }
}
